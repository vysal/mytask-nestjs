# Local Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=mytasks
DB_SSL=false

# Supabase (Project > Connect > Session pooler)
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<your database password>
# DB_DATABASE=postgres
# DB_SSL=true
# DB_SSL_CA=./prod-ca-2021.crt   # only if you get a certificate error

# Fake value for local examples only. Use a long random string in .env
JWT_SECRET=change-me-fake-secret-for-example-only

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
